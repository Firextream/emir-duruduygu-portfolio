# Copy to .env.local (dev) or .env (Docker) and fill in. Never commit real values.
# On Vercel: Project → Settings → Environment Variables (see GO_LIVE.md for which are needed).

# Public site URL (canonical links, feed, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.duruduygu.com

# Where content comes from: files (default — content/ + public/content, edited with Keystatic at
# /keystatic), mock (the original placeholder set, for tests) or directus (optional, see SCHEMA.md)
CONTENT_SOURCE=files

# --- Keystatic, GitHub mode (production) — see KEYSTATIC.md -------------------------------------
# From the GitHub App (Settings → Developer settings → GitHub Apps → yours)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=
# The GitHub App's slug (github.com/apps/<slug>)
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# GitHub accounts allowed into /keystatic, comma-separated (recommended)
KEYSTATIC_ALLOWED_GITHUB_USERS=Firextream
# Optional: the repo Keystatic commits to (default Firextream/emir-duruduygu-portfolio)
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
# Local only: "local" makes a production build save to disk, to try the editor on this machine.
# Never set it on Vercel.
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# --- Forms: Resend (contact + newsletter) — see GO_LIVE.md -------------------------------------
# Without a key both forms answer 503 with a clear message (never a fake "sent").
RESEND_API_KEY=
# Defaults: from "duruduygu.com <emir@duruduygu.com>", to emir@duruduygu.com
RESEND_FROM=
CONTACT_TO=
# Newsletter segment (Resend renamed audiences to segments; an old audience id works here too)
RESEND_SEGMENT_ID=

# --- Directus (only read when CONTENT_SOURCE=directus) — see SCHEMA.md and DIRECTUS_SETUP.md ---
# URL the Next.js server uses to reach Directus (in Docker this can be http://directus:8055)
DIRECTUS_URL=
# Public URL browsers use for images (e.g. https://cms.duruduygu.com). Defaults to DIRECTUS_URL.
DIRECTUS_ASSETS_URL=
# Read-only static token (optional if the Public role can read the collections)
DIRECTUS_STATIC_TOKEN=
# Optional collection name overrides
DIRECTUS_POSTS_COLLECTION=posts
DIRECTUS_GALLERY_COLLECTION=photos
DIRECTUS_MOODBOARD_COLLECTION=mood
DIRECTUS_PROJECTS_COLLECTION=projects
DIRECTUS_PROJECT_LOG_COLLECTION=project_log
DIRECTUS_SETTINGS_COLLECTION=settings
DIRECTUS_ABOUT_COLLECTION=about
# Shared secret for /api/revalidate (Directus Flow webhook). Required for revalidation to run.
REVALIDATE_SECRET=

# --- Docker self-hosting (docker-compose.example.yml) -------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
