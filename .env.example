# Copy to .env.local (dev) or .env (Docker) and fill in. Never commit real values.

# Where content comes from: mock (default, files in lib/content/mock + public/content) or directus
CONTENT_SOURCE=mock

# Public site URL (feed, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.duruduygu.com

# --- Directus (only read when CONTENT_SOURCE=directus) — see SCHEMA.md and DIRECTUS_SETUP.md ---
# URL the Next.js server uses to reach Directus (in Docker this can be http://directus:8055)
DIRECTUS_URL=
# Public URL browsers use for images (e.g. https://cms.duruduygu.com). Defaults to DIRECTUS_URL.
DIRECTUS_ASSETS_URL=
# Read-only static token (optional if the Public role can read the collections)
DIRECTUS_STATIC_TOKEN=
# Optional collection name overrides
DIRECTUS_POSTS_COLLECTION=posts
DIRECTUS_GALLERY_COLLECTION=photos
DIRECTUS_MOODBOARD_COLLECTION=mood
DIRECTUS_PROJECTS_COLLECTION=projects
DIRECTUS_PROJECT_LOG_COLLECTION=project_log
DIRECTUS_SETTINGS_COLLECTION=settings
DIRECTUS_ABOUT_COLLECTION=about

# Shared secret for /api/revalidate (Directus Flow webhook). Required for revalidation to run.
REVALIDATE_SECRET=

# --- Docker self-hosting (docker-compose.example.yml) ---
CLOUDFLARE_TUNNEL_TOKEN=
